        '#withHttpHeaders':: d.fn(help='"HTTP headers to use for all responses from these URLs.\\nAn object containing a list of \\"key:value\\" value pairs.\\"."', args=[d.arg(name='httpHeaders', type=d.T.object)]),
        withHttpHeaders(httpHeaders): { staticFiles+: { httpHeaders: httpHeaders } },
        '#withHttpHeadersMixin':: d.fn(help='"HTTP headers to use for all responses from these URLs.\\nAn object containing a list of \\"key:value\\" value pairs.\\"."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='httpHeaders', type=d.T.object)]),
        withHttpHeadersMixin(httpHeaders): { staticFiles+: { httpHeaders+: httpHeaders } },
        '#withMimeType':: d.fn(help="\"MIME type used to serve all files served by this handler.\\nDefaults to file-specific MIME types, which are derived from each file's filename extension.\"", args=[d.arg(name='mimeType', type=d.T.string)]),
        withMimeType(mimeType): { staticFiles+: { mimeType: mimeType } },
        '#withPath':: d.fn(help='"Path to the static files matched by the URL pattern, from the application root directory.\\nThe path can refer to text matched in groupings in the URL pattern."', args=[d.arg(name='path', type=d.T.string)]),
        withPath(path): { staticFiles+: { path: path } },
        '#withRequireMatchingFile':: d.fn(help='"Whether this handler should match the request if the file referenced by the handler does not exist."', args=[d.arg(name='requireMatchingFile', type=d.T.boolean)]),
        withRequireMatchingFile(requireMatchingFile): { staticFiles+: { requireMatchingFile: requireMatchingFile } },
        '#withUploadPathRegex':: d.fn(help='"Regular expression that matches the file paths for all files that should be referenced by this handler."', args=[d.arg(name='uploadPathRegex', type=d.T.string)]),
        withUploadPathRegex(uploadPathRegex): { staticFiles+: { uploadPathRegex: uploadPathRegex } },
      },
      '#withAuthFailAction':: d.fn(help='"Actions to take when the user is not logged in. Possible values: [\\"AUTH_FAIL_ACTION_REDIRECT\\", \\"AUTH_FAIL_ACTION_UNAUTHORIZED\\"]."', args=[d.arg(name='authFailAction', type=d.T.string)]),
      withAuthFailAction(authFailAction): { authFailAction: authFailAction },
      '#withLogin':: d.fn(help='"Methods to restrict access to a URL based on login status. Possible values: [\\"LOGIN_OPTIONAL\\", \\"LOGIN_ADMIN\\", \\"LOGIN_REQUIRED\\"]."', args=[d.arg(name='login', type=d.T.string)]),
      withLogin(login): { login: login },
      '#withRedirectHttpResponseCode':: d.fn(help='"30x code to use when performing redirects for the secure field. Possible values: [\\"REDIRECT_HTTP_RESPONSE_CODE_301\\", \\"REDIRECT_HTTP_RESPONSE_CODE_302\\", \\"REDIRECT_HTTP_RESPONSE_CODE_303\\", \\"REDIRECT_HTTP_RESPONSE_CODE_307\\"]."', args=[d.arg(name='redirectHttpResponseCode', type=d.T.string)]),
      withRedirectHttpResponseCode(redirectHttpResponseCode): { redirectHttpResponseCode: redirectHttpResponseCode },
      '#withSecurityLevel':: d.fn(help='"Security (HTTPS) enforcement for this URL. Possible values: [\\"SECURE_DEFAULT\\", \\"SECURE_NEVER\\", \\"SECURE_OPTIONAL\\", \\"SECURE_ALWAYS\\"]."', args=[d.arg(name='securityLevel', type=d.T.string)]),
      withSecurityLevel(securityLevel): { securityLevel: securityLevel },
      '#withUrlRegex':: d.fn(help='"URL prefix. Uses regular expression syntax, which means regexp special characters must be escaped, but should not contain groupings.\\nAll URLs that begin with this prefix are handled by this handler, using the portion of the URL after the prefix as part of the file path."', args=[d.arg(name='urlRegex', type=d.T.string)]),
      withUrlRegex(urlRegex): { urlRegex: urlRegex },
    },
    '#livenessCheck':: d.obj(help='"Health checking configuration for VM instances. Unhealthy instances are killed and replaced with new instances."'),
    livenessCheck: {
      '#withCheckInterval':: d.fn(help='"Interval between health checks."', args=[d.arg(name='checkInterval', type=d.T.string)]),
      withCheckInterval(checkInterval): { spec+: { livenessCheck+: { checkInterval: checkInterval } } },
      '#withFailureThreshold':: d.fn(help='"Number of consecutive failed checks required before considering the VM unhealthy. Default: 4."', args=[d.arg(name='failureThreshold', type=d.T.number)]),
      withFailureThreshold(failureThreshold): { spec+: { livenessCheck+: { failureThreshold: failureThreshold } } },
      '#withHost':: d.fn(help='"Host header to send when performing a HTTP Readiness check. Example: \\"myapp.appspot.com\\"."', args=[d.arg(name='host', type=d.T.string)]),
      withHost(host): { spec+: { livenessCheck+: { host: host } } },
      '#withInitialDelay':: d.fn(help='"The initial delay before starting to execute the checks. Default: \\"300s\\"."', args=[d.arg(name='initialDelay', type=d.T.string)]),
      withInitialDelay(initialDelay): { spec+: { livenessCheck+: { initialDelay: initialDelay } } },
      '#withPath':: d.fn(help='"The request path."', args=[d.arg(name='path', type=d.T.string)]),
      withPath(path): { spec+: { livenessCheck+: { path: path } } },
      '#withSuccessThreshold':: d.fn(help='"Number of consecutive successful checks required before considering the VM healthy. Default: 2."', args=[d.arg(name='successThreshold', type=d.T.number)]),
      withSuccessThreshold(successThreshold): { spec+: { livenessCheck+: { successThreshold: successThreshold } } },
      '#withTimeout':: d.fn(help='"Time before the check is considered failed. Default: \\"4s\\"."', args=[d.arg(name='timeout', type=d.T.string)]),
      withTimeout(timeout): { spec+: { livenessCheck+: { timeout: timeout } } },
    },
    '#manualScaling':: d.obj(help='"A service with manual scaling runs continuously, allowing you to perform complex initialization and rely on the state of its memory over time."'),
    manualScaling: {
      '#withInstances':: d.fn(help="\"Number of instances to assign to the service at the start.\\n\\n**Note:** When managing the number of instances at runtime through the App Engine Admin API or the (now deprecated) Python 2\\nModules API set_num_instances() you must use 'lifecycle.ignore_changes = [\\\"manual_scaling\\\"[0].instances]' to prevent drift detection.\"", args=[d.arg(name='instances', type=d.T.integer)]),
      withInstances(instances): { spec+: { manualScaling+: { instances: instances } } },
    },
    '#network':: d.obj(help='"Extra network settings."'),
    network: {
      '#withForwardedPorts':: d.fn(help='"List of ports, or port pairs, to forward from the virtual machine to the application container."', args=[d.arg(name='forwardedPorts', type=d.T.array)]),
      withForwardedPorts(forwardedPorts): { spec+: { network+: { forwardedPorts: if std.isArray(v=forwardedPorts) then forwardedPorts else [forwardedPorts] } } },
      '#withForwardedPortsMixin':: d.fn(help='"List of ports, or port pairs, to forward from the virtual machine to the application container."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='forwardedPorts', type=d.T.array)]),
      withForwardedPortsMixin(forwardedPorts): { spec+: { network+: { forwardedPorts+: if std.isArray(v=forwardedPorts) then forwardedPorts else [forwardedPorts] } } },
      '#withInstanceTag':: d.fn(help='"Tag to apply to the instance during creation."', args=[d.arg(name='instanceTag', type=d.T.string)]),
      withInstanceTag(instanceTag): { spec+: { network+: { instanceTag: instanceTag } } },
      '#withName':: d.fn(help='"Google Compute Engine network where the virtual machines are created. Specify the short name, not the resource path."', args=[d.arg(name='name', type=d.T.string)]),
      withName(name): { spec+: { network+: { name: name } } },
      '#withSessionAffinity':: d.fn(help='"Enable session affinity."', args=[d.arg(name='sessionAffinity', type=d.T.boolean)]),
      withSessionAffinity(sessionAffinity): { spec+: { network+: { sessionAffinity: sessionAffinity } } },
      '#withSubnetwork':: d.fn(help='"Google Cloud Platform sub-network where the virtual machines are created. Specify the short name, not the resource path.\\n\\nIf the network that the instance is being created in is a Legacy network, then the IP address is allocated from the IPv4Range.\\nIf the network that the instance is being created in is an auto Subnet Mode Network, then only network name should be specified (not the subnetworkName) and the IP address is created from the IPCidrRange of the subnetwork that exists in that zone for that network.\\nIf the network that the instance is being created in is a custom Subnet Mode Network, then the subnetworkName must be specified and the IP address is created from the IPCidrRange of the subnetwork.\\nIf specified, the subnetwork must exist in the same region as the App Engine flexible environment application."', args=[d.arg(name='subnetwork', type=d.T.string)]),
      withSubnetwork(subnetwork): { spec+: { network+: { subnetwork: subnetwork } } },
    },
    '#readinessCheck':: d.obj(help='"Configures readiness health checking for instances. Unhealthy instances are not put into the backend traffic rotation."'),
    readinessCheck: {
      '#withAppStartTimeout':: d.fn(help='"A maximum time limit on application initialization, measured from moment the application successfully\\nreplies to a healthcheck until it is ready to serve traffic. Default: \\"300s\\"."', args=[d.arg(name='appStartTimeout', type=d.T.string)]),
      withAppStartTimeout(appStartTimeout): { spec+: { readinessCheck+: { appStartTimeout: appStartTimeout } } },
      '#withCheckInterval':: d.fn(help='"Interval between health checks.  Default: \\"5s\\"."', args=[d.arg(name='checkInterval', type=d.T.string)]),
      withCheckInterval(checkInterval): { spec+: { readinessCheck+: { checkInterval: checkInterval } } },
      '#withFailureThreshold':: d.fn(help='"Number of consecutive failed checks required before removing traffic. Default: 2."', args=[d.arg(name='failureThreshold', type=d.T.number)]),
      withFailureThreshold(failureThreshold): { spec+: { readinessCheck+: { failureThreshold: failureThreshold } } },
      '#withHost':: d.fn(help='"Host header to send when performing a HTTP Readiness check. Example: \\"myapp.appspot.com\\"."', args=[d.arg(name='host', type=d.T.string)]),
      withHost(host): { spec+: { readinessCheck+: { host: host } } },
      '#withPath':: d.fn(help='"The request path."', args=[d.arg(name='path', type=d.T.string)]),
      withPath(path): { spec+: { readinessCheck+: { path: path } } },
      '#withSuccessThreshold':: d.fn(help='"Number of consecutive successful checks required before receiving traffic. Default: 2."', args=[d.arg(name='successThreshold', type=d.T.number)]),
      withSuccessThreshold(successThreshold): { spec+: { readinessCheck+: { successThreshold: successThreshold } } },
      '#withTimeout':: d.fn(help='"Time before the check is considered failed. Default: \\"4s\\"."', args=[d.arg(name='timeout', type=d.T.string)]),
      withTimeout(timeout): { spec+: { readinessCheck+: { timeout: timeout } } },
    },
