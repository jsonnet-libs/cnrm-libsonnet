    withBetaSettings(betaSettings): { spec+: { betaSettings: betaSettings } },
    '#withBetaSettingsMixin':: d.fn(help='"Metadata settings that are supplied to this version to enable beta runtime features."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='betaSettings', type=d.T.object)]),
    withBetaSettingsMixin(betaSettings): { spec+: { betaSettings+: betaSettings } },
    '#withDefaultExpiration':: d.fn(help='"Duration that static files should be cached by web proxies and browsers.\\nOnly applicable if the corresponding StaticFilesHandler does not specify its own expiration time."', args=[d.arg(name='defaultExpiration', type=d.T.string)]),
    withDefaultExpiration(defaultExpiration): { spec+: { defaultExpiration: defaultExpiration } },
    '#withDeleteServiceOnDestroy':: d.fn(help="\"If set to 'true', the service will be deleted if it is the last version.\"", args=[d.arg(name='deleteServiceOnDestroy', type=d.T.boolean)]),
    withDeleteServiceOnDestroy(deleteServiceOnDestroy): { spec+: { deleteServiceOnDestroy: deleteServiceOnDestroy } },
    '#withEnvVariables':: d.fn(help='', args=[d.arg(name='envVariables', type=d.T.object)]),
    withEnvVariables(envVariables): { spec+: { envVariables: envVariables } },
