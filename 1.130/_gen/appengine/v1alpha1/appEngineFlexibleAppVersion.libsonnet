      '#withDiskGb':: d.fn(help='"Disk size (GB) needed."', args=[d.arg(name='diskGb', type=d.T.integer)]),
      withDiskGb(diskGb): { spec+: { resources+: { diskGb: diskGb } } },
      '#withMemoryGb':: d.fn(help='"Memory (GB) needed."', args=[d.arg(name='memoryGb', type=d.T.number)]),
      withMemoryGb(memoryGb): { spec+: { resources+: { memoryGb: memoryGb } } },
      '#withVolumes':: d.fn(help='"List of ports, or port pairs, to forward from the virtual machine to the application container."', args=[d.arg(name='volumes', type=d.T.array)]),
      withVolumes(volumes): { spec+: { resources+: { volumes: if std.isArray(v=volumes) then volumes else [volumes] } } },
      '#withVolumesMixin':: d.fn(help='"List of ports, or port pairs, to forward from the virtual machine to the application container."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='volumes', type=d.T.array)]),
      withVolumesMixin(volumes): { spec+: { resources+: { volumes+: if std.isArray(v=volumes) then volumes else [volumes] } } },
    },
