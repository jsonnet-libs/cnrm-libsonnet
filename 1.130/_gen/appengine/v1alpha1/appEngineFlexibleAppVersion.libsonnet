      '#withName':: d.fn(help='"Name of the referent. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names"', args=[d.arg(name='name', type=d.T.string)]),
      withName(name): { spec+: { serviceRef+: { name: name } } },
      '#withNamespace':: d.fn(help='"Namespace of the referent. More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/namespaces/"', args=[d.arg(name='namespace', type=d.T.string)]),
      withNamespace(namespace): { spec+: { serviceRef+: { namespace: namespace } } },
    },
    '#vpcAccessConnector':: d.obj(help='"Enables VPC connectivity for standard apps."'),
    vpcAccessConnector: {
      '#withName':: d.fn(help='"Full Serverless VPC Access Connector name e.g. /projects/my-project/locations/us-central1/connectors/c1."', args=[d.arg(name='name', type=d.T.string)]),
      withName(name): { spec+: { vpcAccessConnector+: { name: name } } },
