        '#withVolumeType':: d.fn(help="\"Underlying volume type, e.g. 'tmpfs'.\"", args=[d.arg(name='volumeType', type=d.T.string)]),
        withVolumeType(volumeType): { volumeType: volumeType },
      },
      '#withCpu':: d.fn(help='"Number of CPU cores needed."', args=[d.arg(name='cpu', type=d.T.integer)]),
