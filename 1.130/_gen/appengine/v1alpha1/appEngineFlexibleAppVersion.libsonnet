    withEnvVariablesMixin(envVariables): { spec+: { envVariables+: envVariables } },
    '#withHandlers':: d.fn(help='"An ordered list of URL-matching patterns that should be applied to incoming requests.\\nThe first matching URL handles the request and other request handlers are not attempted."', args=[d.arg(name='handlers', type=d.T.array)]),
    withHandlers(handlers): { spec+: { handlers: if std.isArray(v=handlers) then handlers else [handlers] } },
    '#withHandlersMixin':: d.fn(help='"An ordered list of URL-matching patterns that should be applied to incoming requests.\\nThe first matching URL handles the request and other request handlers are not attempted."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='handlers', type=d.T.array)]),
    withHandlersMixin(handlers): { spec+: { handlers+: if std.isArray(v=handlers) then handlers else [handlers] } },
    '#withInboundServices':: d.fn(help='"A list of the types of messages that this application is able to receive. Possible values: [\\"INBOUND_SERVICE_MAIL\\", \\"INBOUND_SERVICE_MAIL_BOUNCE\\", \\"INBOUND_SERVICE_XMPP_ERROR\\", \\"INBOUND_SERVICE_XMPP_MESSAGE\\", \\"INBOUND_SERVICE_XMPP_SUBSCRIBE\\", \\"INBOUND_SERVICE_XMPP_PRESENCE\\", \\"INBOUND_SERVICE_CHANNEL_PRESENCE\\", \\"INBOUND_SERVICE_WARMUP\\"]."', args=[d.arg(name='inboundServices', type=d.T.array)]),
    withInboundServices(inboundServices): { spec+: { inboundServices: if std.isArray(v=inboundServices) then inboundServices else [inboundServices] } },
    '#withInboundServicesMixin':: d.fn(help='"A list of the types of messages that this application is able to receive. Possible values: [\\"INBOUND_SERVICE_MAIL\\", \\"INBOUND_SERVICE_MAIL_BOUNCE\\", \\"INBOUND_SERVICE_XMPP_ERROR\\", \\"INBOUND_SERVICE_XMPP_MESSAGE\\", \\"INBOUND_SERVICE_XMPP_SUBSCRIBE\\", \\"INBOUND_SERVICE_XMPP_PRESENCE\\", \\"INBOUND_SERVICE_CHANNEL_PRESENCE\\", \\"INBOUND_SERVICE_WARMUP\\"]."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='inboundServices', type=d.T.array)]),
    withInboundServicesMixin(inboundServices): { spec+: { inboundServices+: if std.isArray(v=inboundServices) then inboundServices else [inboundServices] } },
    '#withInstanceClass':: d.fn(help='"Instance class that is used to run this version. Valid values are\\nAutomaticScaling: F1, F2, F4, F4_1G\\nManualScaling: B1, B2, B4, B8, B4_1G\\nDefaults to F1 for AutomaticScaling and B1 for ManualScaling."', args=[d.arg(name='instanceClass', type=d.T.string)]),
    withInstanceClass(instanceClass): { spec+: { instanceClass: instanceClass } },
    '#withNobuildFilesRegex':: d.fn(help='"Files that match this pattern will not be built into this version. Only applicable for Go runtimes."', args=[d.arg(name='nobuildFilesRegex', type=d.T.string)]),
    withNobuildFilesRegex(nobuildFilesRegex): { spec+: { nobuildFilesRegex: nobuildFilesRegex } },
    '#withNoopOnDestroy':: d.fn(help="\"If set to 'true', the application version will not be deleted.\"", args=[d.arg(name='noopOnDestroy', type=d.T.boolean)]),
    withNoopOnDestroy(noopOnDestroy): { spec+: { noopOnDestroy: noopOnDestroy } },
    '#withProject':: d.fn(help='"Immutable."', args=[d.arg(name='project', type=d.T.string)]),
    withProject(project): { spec+: { project: project } },
    '#withResourceID':: d.fn(help='"Immutable. Optional. The versionId of the resource. Used for creation and acquisition. When unset, the value of `metadata.name` is used as the default."', args=[d.arg(name='resourceID', type=d.T.string)]),
    withResourceID(resourceID): { spec+: { resourceID: resourceID } },
    '#withRuntime':: d.fn(help='"Desired runtime. Example python27."', args=[d.arg(name='runtime', type=d.T.string)]),
