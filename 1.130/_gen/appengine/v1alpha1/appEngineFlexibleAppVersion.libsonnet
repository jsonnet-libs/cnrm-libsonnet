    withServiceAccount(serviceAccount): { spec+: { serviceAccount: serviceAccount } },
    '#withServingStatus':: d.fn(help='"Current serving status of this version. Only the versions with a SERVING status create instances and can be billed. Default value: \\"SERVING\\" Possible values: [\\"SERVING\\", \\"STOPPED\\"]."', args=[d.arg(name='servingStatus', type=d.T.string)]),
    withServingStatus(servingStatus): { spec+: { servingStatus: servingStatus } },
  },
  '#mixin': 'ignore',
  mixin: self,
}
