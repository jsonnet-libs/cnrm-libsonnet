      timeOfDay: {
        '#withHours':: d.fn(help='"Immutable. Hours of day in 24 hour format. Should be from 0 to 23.\\nAn API may choose to allow the value \\"24:00:00\\" for scenarios like business closing time."', args=[d.arg(name='hours', type=d.T.integer)]),
        withHours(hours): { spec+: { recurringSchedule+: { timeOfDay+: { hours: hours } } } },
        '#withMinutes':: d.fn(help='"Immutable. Minutes of hour of day. Must be from 0 to 59."', args=[d.arg(name='minutes', type=d.T.integer)]),
        withMinutes(minutes): { spec+: { recurringSchedule+: { timeOfDay+: { minutes: minutes } } } },
        '#withNanos':: d.fn(help='"Immutable. Fractions of seconds in nanoseconds. Must be from 0 to 999,999,999."', args=[d.arg(name='nanos', type=d.T.integer)]),
        withNanos(nanos): { spec+: { recurringSchedule+: { timeOfDay+: { nanos: nanos } } } },
        '#withSeconds':: d.fn(help='"Immutable. Seconds of minutes of the time. Must normally be from 0 to 59. An API may allow the value 60 if it allows leap-seconds."', args=[d.arg(name='seconds', type=d.T.integer)]),
        withSeconds(seconds): { spec+: { recurringSchedule+: { timeOfDay+: { seconds: seconds } } } },
      },
      '#timeZone':: d.obj(help='"Immutable. Defines the time zone that timeOfDay is relative to. The rules for daylight saving time are\\ndetermined by the chosen time zone."'),
