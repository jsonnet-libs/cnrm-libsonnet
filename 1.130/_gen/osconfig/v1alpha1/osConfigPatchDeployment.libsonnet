        withId(id): { spec+: { recurringSchedule+: { timeZone+: { id: id } } } },
        '#withVersion':: d.fn(help='"Immutable. IANA Time Zone Database version number, e.g. \\"2019a\\"."', args=[d.arg(name='version', type=d.T.string)]),
        withVersion(version): { spec+: { recurringSchedule+: { timeZone+: { version: version } } } },
