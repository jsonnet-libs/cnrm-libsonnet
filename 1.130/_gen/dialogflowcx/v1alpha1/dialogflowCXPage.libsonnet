        '#withConditionalCases':: d.fn(help='"Conditional cases for this fulfillment."', args=[d.arg(name='conditionalCases', type=d.T.array)]),
        withConditionalCases(conditionalCases): { triggerFulfillment+: { conditionalCases: if std.isArray(v=conditionalCases) then conditionalCases else [conditionalCases] } },
        '#withConditionalCasesMixin':: d.fn(help='"Conditional cases for this fulfillment."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='conditionalCases', type=d.T.array)]),
        withConditionalCasesMixin(conditionalCases): { triggerFulfillment+: { conditionalCases+: if std.isArray(v=conditionalCases) then conditionalCases else [conditionalCases] } },
        '#withMessages':: d.fn(help='"The list of rich message responses to present to the user."', args=[d.arg(name='messages', type=d.T.array)]),
        withMessages(messages): { triggerFulfillment+: { messages: if std.isArray(v=messages) then messages else [messages] } },
        '#withMessagesMixin':: d.fn(help='"The list of rich message responses to present to the user."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='messages', type=d.T.array)]),
        withMessagesMixin(messages): { triggerFulfillment+: { messages+: if std.isArray(v=messages) then messages else [messages] } },
        '#withReturnPartialResponses':: d.fn(help='"Whether Dialogflow should return currently queued fulfillment response messages in streaming APIs. If a webhook is specified, it happens before Dialogflow invokes webhook. Warning: 1) This flag only affects streaming API. Responses are still queued and returned once in non-streaming API. 2) The flag can be enabled in any fulfillment but only the first 3 partial responses will be returned. You may only want to apply it to fulfillments that have slow webhooks."', args=[d.arg(name='returnPartialResponses', type=d.T.boolean)]),
        withReturnPartialResponses(returnPartialResponses): { triggerFulfillment+: { returnPartialResponses: returnPartialResponses } },
        '#withSetParameterActions':: d.fn(help='"Set parameter values before executing the webhook."', args=[d.arg(name='setParameterActions', type=d.T.array)]),
        withSetParameterActions(setParameterActions): { triggerFulfillment+: { setParameterActions: if std.isArray(v=setParameterActions) then setParameterActions else [setParameterActions] } },
        '#withSetParameterActionsMixin':: d.fn(help='"Set parameter values before executing the webhook."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='setParameterActions', type=d.T.array)]),
        withSetParameterActionsMixin(setParameterActions): { triggerFulfillment+: { setParameterActions+: if std.isArray(v=setParameterActions) then setParameterActions else [setParameterActions] } },
        '#withTag':: d.fn(help='"The tag used by the webhook to identify which fulfillment is being called. This field is required if webhook is specified."', args=[d.arg(name='tag', type=d.T.string)]),
        withTag(tag): { triggerFulfillment+: { tag: tag } },
        '#withWebhook':: d.fn(help='"The webhook to call. Format: projects/<Project ID>/locations/<Location ID>/agents/<Agent ID>/webhooks/<Webhook ID>."', args=[d.arg(name='webhook', type=d.T.string)]),
        withWebhook(webhook): { triggerFulfillment+: { webhook: webhook } },
      },
      '#withCondition':: d.fn(help='"The condition to evaluate against form parameters or session parameters.\\nAt least one of intent or condition must be specified. When both intent and condition are specified, the transition can only happen when both are fulfilled."', args=[d.arg(name='condition', type=d.T.string)]),
      withCondition(condition): { condition: condition },
      '#withIntent':: d.fn(help='"The unique identifier of an Intent.\\nFormat: projects/<Project ID>/locations/<Location ID>/agents/<Agent ID>/intents/<Intent ID>. Indicates that the transition can only happen when the given intent is matched. At least one of intent or condition must be specified. When both intent and condition are specified, the transition can only happen when both are fulfilled."', args=[d.arg(name='intent', type=d.T.string)]),
      withIntent(intent): { intent: intent },
      '#withName':: d.fn(help='"The unique identifier of this transition route."', args=[d.arg(name='name', type=d.T.string)]),
      withName(name): { name: name },
      '#withTargetFlow':: d.fn(help='"The target flow to transition to.\\nFormat: projects/<Project ID>/locations/<Location ID>/agents/<Agent ID>/flows/<Flow ID>."', args=[d.arg(name='targetFlow', type=d.T.string)]),
      withTargetFlow(targetFlow): { targetFlow: targetFlow },
      '#withTargetPage':: d.fn(help='"The target page to transition to.\\nFormat: projects/<Project ID>/locations/<Location ID>/agents/<Agent ID>/flows/<Flow ID>/pages/<Page ID>."', args=[d.arg(name='targetPage', type=d.T.string)]),
      withTargetPage(targetPage): { targetPage: targetPage },
    },
    '#withDisplayName':: d.fn(help='"The human-readable name of the page, unique within the agent."', args=[d.arg(name='displayName', type=d.T.string)]),
    withDisplayName(displayName): { spec+: { displayName: displayName } },
    '#withEventHandlers':: d.fn(help='"Handlers associated with the page to handle events such as webhook errors, no match or no input."', args=[d.arg(name='eventHandlers', type=d.T.array)]),
    withEventHandlers(eventHandlers): { spec+: { eventHandlers: if std.isArray(v=eventHandlers) then eventHandlers else [eventHandlers] } },
    '#withEventHandlersMixin':: d.fn(help='"Handlers associated with the page to handle events such as webhook errors, no match or no input."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='eventHandlers', type=d.T.array)]),
    withEventHandlersMixin(eventHandlers): { spec+: { eventHandlers+: if std.isArray(v=eventHandlers) then eventHandlers else [eventHandlers] } },
    '#withLanguageCode':: d.fn(help="\"Immutable. The language of the following fields in page:\\n\\nPage.entry_fulfillment.messages\\nPage.entry_fulfillment.conditional_cases\\nPage.event_handlers.trigger_fulfillment.messages\\nPage.event_handlers.trigger_fulfillment.conditional_cases\\nPage.form.parameters.fill_behavior.initial_prompt_fulfillment.messages\\nPage.form.parameters.fill_behavior.initial_prompt_fulfillment.conditional_cases\\nPage.form.parameters.fill_behavior.reprompt_event_handlers.messages\\nPage.form.parameters.fill_behavior.reprompt_event_handlers.conditional_cases\\nPage.transition_routes.trigger_fulfillment.messages\\nPage.transition_routes.trigger_fulfillment.conditional_cases\\nIf not specified, the agent's default language is used. Many languages are supported. Note: languages must be enabled in the agent before they can be used.\"", args=[d.arg(name='languageCode', type=d.T.string)]),
    withLanguageCode(languageCode): { spec+: { languageCode: languageCode } },
    '#withParent':: d.fn(help='"Immutable. The flow to create a page for.\\nFormat: projects/<Project ID>/locations/<Location ID>/agents/<Agent ID>/flows/<Flow ID>."', args=[d.arg(name='parent', type=d.T.string)]),
    withParent(parent): { spec+: { parent: parent } },
    '#withResourceID':: d.fn(help='"Immutable. Optional. The service-generated name of the resource. Used for acquisition only. Leave unset to create a new resource."', args=[d.arg(name='resourceID', type=d.T.string)]),
    withResourceID(resourceID): { spec+: { resourceID: resourceID } },
    '#withTransitionRouteGroups':: d.fn(help="\"Ordered list of TransitionRouteGroups associated with the page. Transition route groups must be unique within a page.\\nIf multiple transition routes within a page scope refer to the same intent, then the precedence order is: page's transition route -\u003e page's transition route group -\u003e flow's transition routes.\\nIf multiple transition route groups within a page contain the same intent, then the first group in the ordered list takes precedence.\\nFormat:projects/\u003cProject ID\u003e/locations/\u003cLocation ID\u003e/agents/\u003cAgent ID\u003e/flows/\u003cFlow ID\u003e/transitionRouteGroups/\u003cTransitionRouteGroup ID\u003e.\"", args=[d.arg(name='transitionRouteGroups', type=d.T.array)]),
    withTransitionRouteGroups(transitionRouteGroups): { spec+: { transitionRouteGroups: if std.isArray(v=transitionRouteGroups) then transitionRouteGroups else [transitionRouteGroups] } },
    '#withTransitionRouteGroupsMixin':: d.fn(help="\"Ordered list of TransitionRouteGroups associated with the page. Transition route groups must be unique within a page.\\nIf multiple transition routes within a page scope refer to the same intent, then the precedence order is: page's transition route -\u003e page's transition route group -\u003e flow's transition routes.\\nIf multiple transition route groups within a page contain the same intent, then the first group in the ordered list takes precedence.\\nFormat:projects/\u003cProject ID\u003e/locations/\u003cLocation ID\u003e/agents/\u003cAgent ID\u003e/flows/\u003cFlow ID\u003e/transitionRouteGroups/\u003cTransitionRouteGroup ID\u003e.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='transitionRouteGroups', type=d.T.array)]),
    withTransitionRouteGroupsMixin(transitionRouteGroups): { spec+: { transitionRouteGroups+: if std.isArray(v=transitionRouteGroups) then transitionRouteGroups else [transitionRouteGroups] } },
    '#withTransitionRoutes':: d.fn(help='"A list of transitions for the transition rules of this page. They route the conversation to another page in the same flow, or another flow.\\nWhen we are in a certain page, the TransitionRoutes are evalauted in the following order:\\nTransitionRoutes defined in the page with intent specified.\\nTransitionRoutes defined in the transition route groups with intent specified.\\nTransitionRoutes defined in flow with intent specified.\\nTransitionRoutes defined in the transition route groups with intent specified.\\nTransitionRoutes defined in the page with only condition specified.\\nTransitionRoutes defined in the transition route groups with only condition specified."', args=[d.arg(name='transitionRoutes', type=d.T.array)]),
    withTransitionRoutes(transitionRoutes): { spec+: { transitionRoutes: if std.isArray(v=transitionRoutes) then transitionRoutes else [transitionRoutes] } },
    '#withTransitionRoutesMixin':: d.fn(help='"A list of transitions for the transition rules of this page. They route the conversation to another page in the same flow, or another flow.\\nWhen we are in a certain page, the TransitionRoutes are evalauted in the following order:\\nTransitionRoutes defined in the page with intent specified.\\nTransitionRoutes defined in the transition route groups with intent specified.\\nTransitionRoutes defined in flow with intent specified.\\nTransitionRoutes defined in the transition route groups with intent specified.\\nTransitionRoutes defined in the page with only condition specified.\\nTransitionRoutes defined in the transition route groups with only condition specified."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='transitionRoutes', type=d.T.array)]),
    withTransitionRoutesMixin(transitionRoutes): { spec+: { transitionRoutes+: if std.isArray(v=transitionRoutes) then transitionRoutes else [transitionRoutes] } },
