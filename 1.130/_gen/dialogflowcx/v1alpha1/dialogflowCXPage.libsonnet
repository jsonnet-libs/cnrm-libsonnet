                withAllowPlaybackInterruption(allowPlaybackInterruption): { playAudio+: { allowPlaybackInterruption: allowPlaybackInterruption } },
                '#withAudioUri':: d.fn(help='"URI of the audio clip. Dialogflow does not impose any validation on this value. It is specific to the client that reads it."', args=[d.arg(name='audioUri', type=d.T.string)]),
