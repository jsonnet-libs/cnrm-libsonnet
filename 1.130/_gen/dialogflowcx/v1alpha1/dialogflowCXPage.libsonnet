          '#withRepromptEventHandlers':: d.fn(help="\"The handlers for parameter-level events, used to provide reprompt for the parameter or transition to a different page/flow. The supported events are:\\n* sys.no-match-\u003cN\u003e, where N can be from 1 to 6\\n* sys.no-match-default\\n* sys.no-input-\u003cN\u003e, where N can be from 1 to 6\\n* sys.no-input-default\\n* sys.invalid-parameter\\n[initialPromptFulfillment][initialPromptFulfillment] provides the first prompt for the parameter.\\nIf the user's response does not fill the parameter, a no-match/no-input event will be triggered, and the fulfillment associated with the sys.no-match-1/sys.no-input-1 handler (if defined) will be called to provide a prompt. The sys.no-match-2/sys.no-input-2 handler (if defined) will respond to the next no-match/no-input event, and so on.\\nA sys.no-match-default or sys.no-input-default handler will be used to handle all following no-match/no-input events after all numbered no-match/no-input handlers for the parameter are consumed.\\nA sys.invalid-parameter handler can be defined to handle the case where the parameter values have been invalidated by webhook. For example, if the user's response fill the parameter, however the parameter was invalidated by webhook, the fulfillment associated with the sys.invalid-parameter handler (if defined) will be called to provide a prompt.\\nIf the event handler for the corresponding event can't be found on the parameter, initialPromptFulfillment will be re-prompted.\"", args=[d.arg(name='repromptEventHandlers', type=d.T.array)]),
          withRepromptEventHandlers(repromptEventHandlers): { fillBehavior+: { repromptEventHandlers: if std.isArray(v=repromptEventHandlers) then repromptEventHandlers else [repromptEventHandlers] } },
          '#withRepromptEventHandlersMixin':: d.fn(help="\"The handlers for parameter-level events, used to provide reprompt for the parameter or transition to a different page/flow. The supported events are:\\n* sys.no-match-\u003cN\u003e, where N can be from 1 to 6\\n* sys.no-match-default\\n* sys.no-input-\u003cN\u003e, where N can be from 1 to 6\\n* sys.no-input-default\\n* sys.invalid-parameter\\n[initialPromptFulfillment][initialPromptFulfillment] provides the first prompt for the parameter.\\nIf the user's response does not fill the parameter, a no-match/no-input event will be triggered, and the fulfillment associated with the sys.no-match-1/sys.no-input-1 handler (if defined) will be called to provide a prompt. The sys.no-match-2/sys.no-input-2 handler (if defined) will respond to the next no-match/no-input event, and so on.\\nA sys.no-match-default or sys.no-input-default handler will be used to handle all following no-match/no-input events after all numbered no-match/no-input handlers for the parameter are consumed.\\nA sys.invalid-parameter handler can be defined to handle the case where the parameter values have been invalidated by webhook. For example, if the user's response fill the parameter, however the parameter was invalidated by webhook, the fulfillment associated with the sys.invalid-parameter handler (if defined) will be called to provide a prompt.\\nIf the event handler for the corresponding event can't be found on the parameter, initialPromptFulfillment will be re-prompted.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='repromptEventHandlers', type=d.T.array)]),
          withRepromptEventHandlersMixin(repromptEventHandlers): { fillBehavior+: { repromptEventHandlers+: if std.isArray(v=repromptEventHandlers) then repromptEventHandlers else [repromptEventHandlers] } },
        },
        '#withDefaultValue':: d.fn(help='"The default value of an optional parameter. If the parameter is required, the default value will be ignored."', args=[d.arg(name='defaultValue', type=d.T.string)]),
        withDefaultValue(defaultValue): { defaultValue: defaultValue },
        '#withDisplayName':: d.fn(help='"The human-readable name of the parameter, unique within the form."', args=[d.arg(name='displayName', type=d.T.string)]),
        withDisplayName(displayName): { displayName: displayName },
        '#withEntityType':: d.fn(help='"The entity type of the parameter.\\nFormat: projects/-/locations/-/agents/-/entityTypes/<System Entity Type ID> for system entity types (for example, projects/-/locations/-/agents/-/entityTypes/sys.date), or projects/<Project ID>/locations/<Location ID>/agents/<Agent ID>/entityTypes/<Entity Type ID> for developer entity types."', args=[d.arg(name='entityType', type=d.T.string)]),
        withEntityType(entityType): { entityType: entityType },
        '#withIsList':: d.fn(help='"Indicates whether the parameter represents a list of values."', args=[d.arg(name='isList', type=d.T.boolean)]),
        withIsList(isList): { isList: isList },
        '#withRedact':: d.fn(help='"Indicates whether the parameter content should be redacted in log.\\nIf redaction is enabled, the parameter content will be replaced by parameter name during logging. Note: the parameter content is subject to redaction if either parameter level redaction or entity type level redaction is enabled."', args=[d.arg(name='redact', type=d.T.boolean)]),
        withRedact(redact): { redact: redact },
        '#withRequired':: d.fn(help='"Indicates whether the parameter is required. Optional parameters will not trigger prompts; however, they are filled if the user specifies them.\\nRequired parameters must be filled before form filling concludes."', args=[d.arg(name='required', type=d.T.boolean)]),
        withRequired(required): { required: required },
      },
      '#withParameters':: d.fn(help='"Parameters to collect from the user."', args=[d.arg(name='parameters', type=d.T.array)]),
      withParameters(parameters): { spec+: { form+: { parameters: if std.isArray(v=parameters) then parameters else [parameters] } } },
      '#withParametersMixin':: d.fn(help='"Parameters to collect from the user."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='parameters', type=d.T.array)]),
      withParametersMixin(parameters): { spec+: { form+: { parameters+: if std.isArray(v=parameters) then parameters else [parameters] } } },
    },
    '#transitionRoutes':: d.obj(help='"A list of transitions for the transition rules of this page. They route the conversation to another page in the same flow, or another flow.\\nWhen we are in a certain page, the TransitionRoutes are evalauted in the following order:\\nTransitionRoutes defined in the page with intent specified.\\nTransitionRoutes defined in the transition route groups with intent specified.\\nTransitionRoutes defined in flow with intent specified.\\nTransitionRoutes defined in the transition route groups with intent specified.\\nTransitionRoutes defined in the page with only condition specified.\\nTransitionRoutes defined in the transition route groups with only condition specified."'),
    transitionRoutes: {
      '#triggerFulfillment':: d.obj(help='"The fulfillment to call when the condition is satisfied. At least one of triggerFulfillment and target must be specified. When both are defined, triggerFulfillment is executed first."'),
      triggerFulfillment: {
        '#conditionalCases':: d.obj(help='"Conditional cases for this fulfillment."'),
        conditionalCases: {
          '#withCases':: d.fn(help='"A JSON encoded list of cascading if-else conditions. Cases are mutually exclusive. The first one with a matching condition is selected, all the rest ignored.\\nSee [Case](https://cloud.google.com/dialogflow/cx/docs/reference/rest/v3/Fulfillment#case) for the schema."', args=[d.arg(name='cases', type=d.T.string)]),
          withCases(cases): { cases: cases },
        },
        '#messages':: d.obj(help='"The list of rich message responses to present to the user."'),
        messages: {
          '#conversationSuccess':: d.obj(help="\"Indicates that the conversation succeeded, i.e., the bot handled the issue that the customer talked to it about.\\nDialogflow only uses this to determine which conversations should be counted as successful and doesn't process the metadata in this message in any way. Note that Dialogflow also considers conversations that get to the conversation end page as successful even if they don't return ConversationSuccess.\\nYou may set this, for example:\\n* In the entryFulfillment of a Page if entering the page indicates that the conversation succeeded.\\n* In a webhook response when you determine that you handled the customer issue.\""),
          conversationSuccess: {
            '#withMetadata':: d.fn(help="\"Custom metadata. Dialogflow doesn't impose any structure on this.\"", args=[d.arg(name='metadata', type=d.T.string)]),
            withMetadata(metadata): { conversationSuccess+: { metadata: metadata } },
          },
          '#liveAgentHandoff':: d.obj(help='"Indicates that the conversation should be handed off to a live agent.\\nDialogflow only uses this to determine which conversations were handed off to a human agent for measurement purposes. What else to do with this signal is up to you and your handoff procedures.\\nYou may set this, for example:\\n* In the entryFulfillment of a Page if entering the page indicates something went extremely wrong in the conversation.\\n* In a webhook response when you determine that the customer issue can only be handled by a human."'),
          liveAgentHandoff: {
            '#withMetadata':: d.fn(help="\"Custom metadata. Dialogflow doesn't impose any structure on this.\"", args=[d.arg(name='metadata', type=d.T.string)]),
            withMetadata(metadata): { liveAgentHandoff+: { metadata: metadata } },
          },
          '#outputAudioText':: d.obj(help='"A text or ssml response that is preferentially used for TTS output audio synthesis, as described in the comment on the ResponseMessage message."'),
          outputAudioText: {
            '#withAllowPlaybackInterruption':: d.fn(help="\"Whether the playback of this message can be interrupted by the end user's speech and the client can then starts the next Dialogflow request.\"", args=[d.arg(name='allowPlaybackInterruption', type=d.T.boolean)]),
            withAllowPlaybackInterruption(allowPlaybackInterruption): { outputAudioText+: { allowPlaybackInterruption: allowPlaybackInterruption } },
            '#withSsml':: d.fn(help='"The SSML text to be synthesized. For more information, see SSML."', args=[d.arg(name='ssml', type=d.T.string)]),
            withSsml(ssml): { outputAudioText+: { ssml: ssml } },
            '#withText':: d.fn(help='"The raw text to be synthesized."', args=[d.arg(name='text', type=d.T.string)]),
            withText(text): { outputAudioText+: { text: text } },
          },
          '#playAudio':: d.obj(help='"Specifies an audio clip to be played by the client as part of the response."'),
          playAudio: {
            '#withAllowPlaybackInterruption':: d.fn(help="\"Whether the playback of this message can be interrupted by the end user's speech and the client can then starts the next Dialogflow request.\"", args=[d.arg(name='allowPlaybackInterruption', type=d.T.boolean)]),
            withAllowPlaybackInterruption(allowPlaybackInterruption): { playAudio+: { allowPlaybackInterruption: allowPlaybackInterruption } },
            '#withAudioUri':: d.fn(help='"URI of the audio clip. Dialogflow does not impose any validation on this value. It is specific to the client that reads it."', args=[d.arg(name='audioUri', type=d.T.string)]),
            withAudioUri(audioUri): { playAudio+: { audioUri: audioUri } },
          },
          '#telephonyTransferCall':: d.obj(help='"Represents the signal that telles the client to transfer the phone call connected to the agent to a third-party endpoint."'),
          telephonyTransferCall: {
            '#withPhoneNumber':: d.fn(help='"Transfer the call to a phone number in E.164 format."', args=[d.arg(name='phoneNumber', type=d.T.string)]),
            withPhoneNumber(phoneNumber): { telephonyTransferCall+: { phoneNumber: phoneNumber } },
          },
          '#text':: d.obj(help='"The text response message."'),
          text: {
            '#withAllowPlaybackInterruption':: d.fn(help="\"Whether the playback of this message can be interrupted by the end user's speech and the client can then starts the next Dialogflow request.\"", args=[d.arg(name='allowPlaybackInterruption', type=d.T.boolean)]),
            withAllowPlaybackInterruption(allowPlaybackInterruption): { text+: { allowPlaybackInterruption: allowPlaybackInterruption } },
            '#withText':: d.fn(help='"A collection of text responses."', args=[d.arg(name='text', type=d.T.array)]),
            withText(text): { text+: { text: if std.isArray(v=text) then text else [text] } },
            '#withTextMixin':: d.fn(help='"A collection of text responses."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='text', type=d.T.array)]),
            withTextMixin(text): { text+: { text+: if std.isArray(v=text) then text else [text] } },
          },
          '#withChannel':: d.fn(help='"The channel which the response is associated with. Clients can specify the channel via QueryParameters.channel, and only associated channel response will be returned."', args=[d.arg(name='channel', type=d.T.string)]),
          withChannel(channel): { channel: channel },
          '#withPayload':: d.fn(help='"A custom, platform-specific payload."', args=[d.arg(name='payload', type=d.T.string)]),
          withPayload(payload): { payload: payload },
        },
        '#setParameterActions':: d.obj(help='"Set parameter values before executing the webhook."'),
        setParameterActions: {
          '#withParameter':: d.fn(help='"Display name of the parameter."', args=[d.arg(name='parameter', type=d.T.string)]),
          withParameter(parameter): { parameter: parameter },
          '#withValue':: d.fn(help='"The new JSON-encoded value of the parameter. A null value clears the parameter."', args=[d.arg(name='value', type=d.T.string)]),
          withValue(value): { value: value },
