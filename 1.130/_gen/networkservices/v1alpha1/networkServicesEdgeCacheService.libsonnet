    '#withDisableHttp2':: d.fn(help='"Disables HTTP/2.\\n\\nHTTP/2 (h2) is enabled by default and recommended for performance. HTTP/2 improves connection re-use and reduces connection setup overhead by sending multiple streams over the same connection.\\n\\nSome legacy HTTP clients may have issues with HTTP/2 connections due to broken HTTP/2 implementations. Setting this to true will prevent HTTP/2 from being advertised and negotiated."', args=[d.arg(name='disableHttp2', type=d.T.boolean)]),
