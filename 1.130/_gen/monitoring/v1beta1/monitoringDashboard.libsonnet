    '#withDashboardFiltersMixin':: d.fn(help='"Filters to reduce the amount of data charted based on the filter criteria."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='dashboardFilters', type=d.T.array)]),
    withDashboardFiltersMixin(dashboardFilters): { spec+: { dashboardFilters+: if std.isArray(v=dashboardFilters) then dashboardFilters else [dashboardFilters] } },
    '#withDisplayName':: d.fn(help='"Required. The mutable, human-readable name."', args=[d.arg(name='displayName', type=d.T.string)]),
    withDisplayName(displayName): { spec+: { displayName: displayName } },
    '#withResourceID':: d.fn(help='"Immutable. Optional. The name of the resource. Used for creation and acquisition."', args=[d.arg(name='resourceID', type=d.T.string)]),
    withResourceID(resourceID): { spec+: { resourceID: resourceID } },
  },
  '#mixin': 'ignore',
  mixin: self,
}
