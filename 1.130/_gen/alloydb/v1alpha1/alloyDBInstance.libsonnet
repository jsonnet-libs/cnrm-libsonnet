    withAnnotations(annotations): { spec+: { annotations: annotations } },
    '#withAnnotationsMixin':: d.fn(help='"Annotations to allow client tools to store small amount of arbitrary data. This is distinct from labels."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='annotations', type=d.T.object)]),
    withAnnotationsMixin(annotations): { spec+: { annotations+: annotations } },
    '#withAvailabilityType':: d.fn(help="\"'Availability type of an Instance. Defaults to REGIONAL for both primary and read instances.\\nNote that primary and read instances can have different availability types.\\nOnly READ_POOL instance supports ZONAL type. Users can't specify the zone for READ_POOL instance.\\nZone is automatically chosen from the list of zones in the region specified.\\nRead pool of size 1 can only have zonal availability. Read pools with node count of 2 or more\\ncan have regional availability (nodes are present in 2 or more zones in a region).' Possible values: [\\\"AVAILABILITY_TYPE_UNSPECIFIED\\\", \\\"ZONAL\\\", \\\"REGIONAL\\\"].\"", args=[d.arg(name='availabilityType', type=d.T.string)]),
    withAvailabilityType(availabilityType): { spec+: { availabilityType: availabilityType } },
