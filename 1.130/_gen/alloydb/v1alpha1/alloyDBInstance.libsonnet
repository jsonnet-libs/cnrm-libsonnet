      withEnableOutboundPublicIp(enableOutboundPublicIp): { spec+: { networkConfig+: { enableOutboundPublicIp: enableOutboundPublicIp } } },
      '#withEnablePublicIp':: d.fn(help='"Enabling public ip for the instance. If a user wishes to disable this, please also clear the list of the authorized external networks set on the same instance."', args=[d.arg(name='enablePublicIp', type=d.T.boolean)]),
