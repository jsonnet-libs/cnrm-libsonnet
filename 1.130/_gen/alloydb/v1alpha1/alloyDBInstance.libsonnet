    withGceZone(gceZone): { spec+: { gceZone: gceZone } },
    '#withInstanceType':: d.fn(help='"We recommend that you use `instanceTypeRef` instead.\\nThe type of the instance. Possible values: [PRIMARY, READ_POOL, SECONDARY]"', args=[d.arg(name='instanceType', type=d.T.string)]),
    withInstanceType(instanceType): { spec+: { instanceType: instanceType } },
