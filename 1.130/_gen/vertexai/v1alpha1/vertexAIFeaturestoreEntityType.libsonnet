    withDescription(description): { spec+: { description: description } },
    '#withFeaturestore':: d.fn(help='"Immutable. The name of the Featurestore to use, in the format projects/{project}/locations/{location}/featurestores/{featurestore}."', args=[d.arg(name='featurestore', type=d.T.string)]),
    withFeaturestore(featurestore): { spec+: { featurestore: featurestore } },
    '#withOfflineStorageTtlDays':: d.fn(help='"Config for data retention policy in offline storage. TTL in days for feature values that will be stored in offline storage. The Feature Store offline storage periodically removes obsolete feature values older than offlineStorageTtlDays since the feature generation time. If unset (or explicitly set to 0), default to 4000 days TTL."', args=[d.arg(name='offlineStorageTtlDays', type=d.T.integer)]),
    withOfflineStorageTtlDays(offlineStorageTtlDays): { spec+: { offlineStorageTtlDays: offlineStorageTtlDays } },
    '#withResourceID':: d.fn(help='"Immutable. Optional. The name of the resource. Used for creation and acquisition. When unset, the value of `metadata.name` is used as the default."', args=[d.arg(name='resourceID', type=d.T.string)]),
