        withExternal(external): { spec+: { ipAddress+: { addressRef+: { external: external } } } },
        '#withName':: d.fn(help='"The `name` field of a `ComputeAddress` resource."', args=[d.arg(name='name', type=d.T.string)]),
        withName(name): { spec+: { ipAddress+: { addressRef+: { name: name } } } },
