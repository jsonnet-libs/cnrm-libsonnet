        '#withName':: d.fn(help='"Immutable. Name of the metadata label. The length must be between 1 and 1024 characters, inclusive."', args=[d.arg(name='name', type=d.T.string)]),
        withName(name): { name: name },
        '#withValue':: d.fn(help='"Immutable. The value that the label must match. The value has a maximum length of 1024 characters."', args=[d.arg(name='value', type=d.T.string)]),
        withValue(value): { value: value },
      },
      '#withFilterLabels':: d.fn(help='"Immutable. The list of label value pairs that must match labels in the\\nprovided metadata based on filterMatchCriteria\\n\\nThis list must not be empty and can have at the most 64 entries."', args=[d.arg(name='filterLabels', type=d.T.array)]),
      withFilterLabels(filterLabels): { filterLabels: if std.isArray(v=filterLabels) then filterLabels else [filterLabels] },
      '#withFilterLabelsMixin':: d.fn(help='"Immutable. The list of label value pairs that must match labels in the\\nprovided metadata based on filterMatchCriteria\\n\\nThis list must not be empty and can have at the most 64 entries."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='filterLabels', type=d.T.array)]),
      withFilterLabelsMixin(filterLabels): { filterLabels+: if std.isArray(v=filterLabels) then filterLabels else [filterLabels] },
      '#withFilterMatchCriteria':: d.fn(help='"Immutable. Specifies how individual filterLabel matches within the list of\\nfilterLabels contribute towards the overall metadataFilter match.\\n\\nMATCH_ANY - At least one of the filterLabels must have a matching\\nlabel in the provided metadata.\\nMATCH_ALL - All filterLabels must have matching labels in the\\nprovided metadata. Possible values: [\\"MATCH_ANY\\", \\"MATCH_ALL\\"]."', args=[d.arg(name='filterMatchCriteria', type=d.T.string)]),
